FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        nasm \
        ca-certificates \
        libssl-dev \
        libx264-dev \
        libx265-dev \
        libsvtav1enc-dev \
        libaom-dev \
        libdav1d-dev \
        libvpx-dev \
        libwebp-dev \
        libjxl-dev \
        libopenjp2-7-dev \
        libopus-dev \
        libvorbis-dev \
        libmp3lame-dev \
        libtheora-dev \
        libspeex-dev \
        libgsm1-dev \
        libtwolame-dev \
        libass-dev \
        libfreetype-dev \
        libfontconfig-dev \
        libfribidi-dev \
        libharfbuzz-dev \
        libxml2-dev \
        libzimg-dev \
        libsoxr-dev \
        liblcms2-dev

WORKDIR /src

COPY . .

RUN ./configure \
        --enable-gpl \
        --enable-version3 \
        --enable-openssl \
        --enable-libx264 \
        --enable-libx265 \
        --enable-libsvtav1 \
        --enable-libaom \
        --enable-libdav1d \
        --enable-libvpx \
        --enable-libwebp \
        --enable-libjxl \
        --enable-libopenjpeg \
        --enable-libopus \
        --enable-libvorbis \
        --enable-libmp3lame \
        --enable-libtheora \
        --enable-libspeex \
        --enable-libgsm \
        --enable-libtwolame \
        --enable-libass \
        --enable-libfreetype \
        --enable-libfontconfig \
        --enable-libfribidi \
        --enable-libharfbuzz \
        --enable-libxml2 \
        --enable-libzimg \
        --enable-libsoxr \
        --enable-lcms2 \
        --disable-ffplay \
        --disable-doc && \
    make -j"$(nproc)" ffmpeg ffprobe && \
    install -m 0755 ffmpeg /usr/local/bin/ffmpeg && \
    install -m 0755 ffprobe /usr/local/bin/ffprobe

RUN ffmpeg -version && \
    ffprobe -version

ENTRYPOINT ["ffmpeg"]
